`timescale 1ns / 1ps

module tb;

    parameter systolic_size = 2;
    parameter bit_width     = 8;

    reg  [bit_width-1:0]     in_a_00, in_a_10, in_b_00, in_b_01;
    wire [(bit_width*2)-1:0] out_acc_0 [0:systolic_size-1];
    wire [(bit_width*2)-1:0] out_acc_1 [0:systolic_size-1];

    reg clk, rst;
    reg switch, drain_even, drain_odd;   // 2*(systolic_size-1) = 2 -> indices 0,1,2

    integer i;

    systolic #(
        .systolic_size (systolic_size),
        .bit_width (bit_width)
    ) dut(
        .clk (clk), 
        .rst (rst),
        .drain_even (drain_even),
        .drain_odd (drain_odd),
        .switch (switch),
        .in_a_00 (in_a_00),
        .in_a_10 (in_a_10),
        .in_b_00 (in_b_00),
        .in_b_01 (in_b_01),
        .out_acc_0 (out_acc_0),   // bottom row, bank 0 chain
        .out_acc_1 (out_acc_1)    // bottom row, bank 1 chain
    );

    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    always @(posedge clk) begin
        $strobe("t=%0t | acc0=[%0d %0d] acc1=[%0d %0d]",
                  $time,
                  out_acc_0[0], out_acc_0[1],
                  out_acc_1[0], out_acc_1[1]);
    end

    initial begin
        $dumpfile("waveform.vcd");
        $dumpvars(0, tb);

        // reset
        rst = 1;
        in_a_00 <= 0;
        in_a_10 <= 0;
        in_b_00 <= 0;
        in_b_01 <= 0;

        switch<= 0;
        drain_even <= 0; drain_odd <= 0;

        repeat (3) @(posedge clk);
        rst = 0;

        in_a_00 <= 1; in_a_10 <= 3;
        in_b_00 <= 5; in_b_01 <= 6;
        @(posedge clk);

        in_a_00 <= 2; in_a_10 <= 4;
        in_b_00 <= 7; in_b_01 <= 8;
        @(posedge clk);
        switch<= 1;
        drain_even <= 0; drain_odd <= 0;

        in_a_00 <= 9;  in_a_10 <= 11;
        in_b_00 <= 13; in_b_01 <= 15;
        @(posedge clk);
        switch<= 1;
        drain_odd <= 1;   
        drain_even <= 0;

        in_a_00 <= 10; in_a_10 <= 12;
        in_b_00 <= 14; in_b_01 <= 16;
        @(posedge clk);
        switch<= 0;
        drain_odd <= 1;   
        drain_even <= 0;

        in_a_00 <= 17; in_a_10 <= 19;
        in_b_00 <= 21; in_b_01 <= 23;
        
        @(posedge clk);

        switch<= 0;
        drain_odd <= 0;   
        drain_even <= 1;

        in_a_00 <= 18; in_a_10 <= 22;
        in_b_00 <= 20; in_b_01 <= 24;

        @(posedge clk);
        switch<= 1;
        drain_odd <= 0;   
        drain_even <= 1;

        @(posedge clk);

        // switch[0] <= 1; switch[1] <= 1; switch[2] <= 1; switch[3] <= 0; 
        // drain_e [0] <= 0; drain_o[0] <= 1; drain_e[1] <= 1; drain_o[1] <= 1;

        repeat (systolic_size + 2) @(posedge clk);

        $finish;
    end

endmodule